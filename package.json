{
  "name": "remotion-ad-studio",
  "version": "0.3.1",
  "private": true,
  "description": "AI-assisted product ad video maker built on Remotion (vertical SNS ads / 16:9 / 1:1)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,editor -c blue,magenta \"npm:dev:server\" \"npm:dev:editor\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:editor": "vite",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "studio": "remotion studio src/video/index.ts",
    "make": "tsx scripts/cli.ts make",
    "render": "tsx scripts/cli.ts render",
    "irodori": "bash scripts/start-irodori.sh",
    "audio:build": "tsx scripts/generate-audio.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "5.3.0",
    "@fontsource/m-plus-rounded-1c": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/zod-types": "4.0.529",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "lucide-react": "1.48.0",
    "multer": "2.4.0",
    "openai": "7.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529",
    "sharp": "^0.35.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
