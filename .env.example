# OpenAI API key (台本生成 / キャラクター画像・図解の生成に使用)
OPENAI_API_KEY=

# 使用モデル（未指定ならデフォルト）
# OPENAI_TEXT_MODEL=gpt-5.5
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_IMAGE_MODEL=gpt-image-2

# サーバーポート／待ち受けアドレス（既定はこのPCからのみアクセス可）
# PORT=3210
# HOST=127.0.0.1

# 書き出しに使うChrome/Chromiumを指定したい場合（通常は不要。未指定なら自動ダウンロード）
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome

# ナレーション（ElevenLabs）。API キーは ElevenLabs の「Developers → API Keys」で作成
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v4                # 使えない時は自動で eleven_v3
# ELEVENLABS_STT_MODEL=scribe_v2            # 読み上げの確認（文字起こし）
# ELEVENLABS_VERIFY=1                       # 0 で読み上げの確認をしない
# ELEVENLABS_LANGUAGE=ja
# ELEVENLABS_CONCURRENCY=3                  # 同時に作るセリフの数（プランの同時実行数より小さく）
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# 音声合成のエンジン: auto（= ElevenLabs）| elevenlabs | irodori | openai
# TTS_PROVIDER=auto
# IRODORI_TTS_URL=http://127.0.0.1:8088     # scripts/start-irodori.sh で起動するサーバー
# IRODORI_TTS_MODEL=irodori-tts
# IRODORI_TTS_API_KEY=
# IRODORI_NUM_STEPS=                        # 拡散ステップ数（少ないほど速い。空ならサーバー既定）
# IRODORI_TIMEOUT_SEC=600

# ---- 社内向けに Web 公開する時（docs/deploy.md）----
# 設定すると、会社の Google アカウントでログインした人だけが使えるようになります
# PUBLIC_URL=https://studio.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_ALLOWED_DOMAINS=tetoravr.com
# AUTH_ALLOWED_EMAILS=
# SESSION_SECRET=                            # 32文字以上のランダムな文字列
# CLOUDFLARE_TUNNEL_TOKEN=                   # docker compose --profile tunnel を使う時
