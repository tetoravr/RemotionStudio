# OpenAI API key (台本生成 / ナレーション / キャラクター画像生成に使用)
OPENAI_API_KEY=

# 使用モデル（未指定ならデフォルト）
# OPENAI_TEXT_MODEL=gpt-5.5
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_IMAGE_MODEL=gpt-image-2

# サーバーポート／待ち受けアドレス（既定はこのPCからのみアクセス可）
# PORT=3210
# HOST=127.0.0.1

# 書き出しに使うChrome/Chromiumを指定したい場合（通常は不要。未指定なら自動ダウンロード）
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome
